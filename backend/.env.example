# ─────────────────────────────────────────────
# Queryline Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────

# ── Database (Supabase connection pooler URL) ──
# Get from: Supabase Dashboard → Project Settings → Database → Connection Pooling
# Use the "Transaction" mode URL on port 6543
DATABASE_URL=postgresql://postgres.YOURPROJECT:YOURPASSWORD@aws-0-YOURREGION.pooler.supabase.com:6543/postgres

# ── Server ──
PORT=3001
NODE_ENV=development

# ── CORS ──
# Frontend origin (Vite default dev port)
FRONTEND_URL=http://localhost:5173

# ── LLM — Groq (primary) ──
# Get from: https://console.groq.com
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile

# ── LLM — Google Gemini (fallback) ──
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash

# ── Logging ──
LOG_LEVEL=debug
